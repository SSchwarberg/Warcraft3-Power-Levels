@namespace Warcraft3PowerLevels.Layout
@inherits MainLayoutBase

<div class="app-container">

    <div class="sidebar unified-nav">
        <h3 class="sidebar-title">WC3</h3>
        <!-- UNIT SECTION -->
        <div class="nav-section">
            <p class="section-header @(IsActiveGroup("Units") ? "active" : "")">
                Units
            </p>

            @foreach (var item in LayoutState.UnitLinks)
            {
                <NavLink href="@item.Url"
                         Match="NavLinkMatch.All"
                         class="sub-item">
                    @item.Text
                </NavLink>
            }

        </div>

        <!-- HERO SECTION -->
        <div class="nav-section">
            <p class="section-header @(IsActiveGroup("Heroes") ? "active" : "")">
                Heroes
            </p>

            @foreach (var item in LayoutState.HeroLinks)
            {
                <NavLink href="@item.Url"
                         Match="NavLinkMatch.All" 
                         class="sub-item">@item.Text</NavLink>
            }
        </div>
    </div>

    <div class="main-content">
        @Body
    </div>
</div>
