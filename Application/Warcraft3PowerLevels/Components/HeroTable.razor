@using System.Globalization
@using Warcraft3PowerLevels.Components.Dialogs
@using Warcraft3PowerLevels.Entities.Enumerations
@using Warcraft3PowerLevels.Entities.General

<table class="glassy-table">
    <thead class="no-select">
        <tr>
            <th class="@GetHeaderClass(NameSelector)" @onclick="() => Sort(NameSelector)">
                Name @SortIcon(NameSelector)
            </th>

            <th class="@GetHeaderClass(RaceSelector)" @onclick="() => Sort(RaceSelector)">
                Race @SortIcon(RaceSelector)
            </th>

            <th class="@GetHeaderClass(PrimarySelector)" @onclick="() => Sort(PrimarySelector)">
                Primary @SortIcon(PrimarySelector)
            </th>

            <th class="@GetHeaderClass(StrengthSelector)" @onclick="() => Sort(StrengthSelector)">
                Strength @SortIcon(StrengthSelector)
            </th>

            <th class="@GetHeaderClass(AgilitySelector)" @onclick="() => Sort(AgilitySelector)">
                Agility @SortIcon(AgilitySelector)
            </th>

            <th class="@GetHeaderClass(IntelligenceSelector)" @onclick="() => Sort(IntelligenceSelector)">
                Intelligence @SortIcon(IntelligenceSelector)
            </th>

            <th class="@GetHeaderClass(HealthSelector)" @onclick="() => Sort(HealthSelector)">
                Health @SortIcon(HealthSelector)
            </th>

            <th class="@GetHeaderClass(ArmorSelector)" @onclick="() => Sort(ArmorSelector)">
                Armor @SortIcon(ArmorSelector)
            </th>

            <th class="@GetHeaderClass(RangeSelector)" @onclick="() => Sort(RangeSelector)">
                Range @SortIcon(RangeSelector)
            </th>

            <th class="@GetHeaderClass(AttackSelector)" @onclick="() => Sort(AttackSelector)">
                Attack (Avg.) @SortIcon(AttackSelector)
            </th>

            <th class="@GetHeaderClass(AttackTimeSelector)" @onclick="() => Sort(AttackTimeSelector)">
                Attack Time @SortIcon(AttackTimeSelector)
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var hero in SortState.Apply(Heroes))
        {
            var stats = GetAttributes(hero, Level);

            <tr @onclick="() => ShowDetails(hero)">
                <td>@hero.Name</td>
                <td>@hero.Race</td>
                <td>@hero.PrimaryAttribute</td>

                <td>@stats.str</td>
                <td>@stats.agi</td>
                <td>@stats.intl</td>

                <td>@stats.health</td>
                <td>@stats.armor.ToString("F1")</td>
                <td>@(stats.range == -1 ? "Melee" : stats.range)</td>
                <td>@stats.attack</td>
                <td>@stats.atkTime.ToString("F2")</td>
            </tr>
        }
    </tbody>
</table>

<EntityDetailsDialog Entity="selectedEntity" OnClose="CloseDialog" />

@code {
    [Parameter] public IEnumerable<IHero> Heroes { get; set; } = [];
    [Parameter] public int Level { get; set; }
    [Parameter] public EventCallback<Func<IHero, object>> OnSort { get; set; }
    [Parameter] public SortState<IHero> SortState { get; set; } = new();

    // Shared selector instances (necessary so equality works)
    public static readonly Func<IHero, object> NameSelector = h => h.Name;
    public static readonly Func<IHero, object> RaceSelector = h => h.Race;
    public static readonly Func<IHero, object> PrimarySelector = h => h.PrimaryAttribute;
    public static readonly Func<IHero, object> StrengthSelector = h => h.Strength;
    public static readonly Func<IHero, object> AgilitySelector = h => h.Agility;
    public static readonly Func<IHero, object> IntelligenceSelector = h => h.Intelligence;
    public static readonly Func<IHero, object> HealthSelector = h => h.Health;
    public static readonly Func<IHero, object> ArmorSelector = h => h.Armor;
    public static readonly Func<IHero, object> RangeSelector = h => h.Range;
    public static readonly Func<IHero, object> AttackSelector = h => h.Attack;
    public static readonly Func<IHero, object> AttackTimeSelector = h => h.AttackTime;


    private void Sort(Func<IHero, object> selector)
    {
        OnSort.InvokeAsync(selector);
    }

    private string GetHeaderClass(Func<IHero, object> selector)
    {
        return SortState.KeySelector == selector ? "sorted" : "";
    }

    private RenderFragment SortIcon(Func<IHero, object> selector) => builder =>
    {
        if (SortState.KeySelector != selector)
            return;

        string iconClass = SortState.Direction == SortDirectionEnum.Ascending
            ? "sort-asc"
            : "sort-desc";

        builder.OpenElement(0, "svg");
        builder.AddAttribute(1, "class", $"sort-icon {iconClass}");
        builder.AddAttribute(2, "viewBox", "0 0 24 24");
        builder.AddMarkupContent(3, "<path fill='currentColor' d='M12 4l-6 6h12z'/>");
        builder.CloseElement();
    };

    private (int str, int agi, int intl, int health, double armor, double attack, double atkTime, int range)
        GetAttributes(IHero hero, int level)
    {
        if (level < 1) level = 1;
        int gained = level - 1;

        hero.Level = level;

        int str = hero.Strength;
        int agi = hero.Agility;
        int intl = hero.Intelligence;

        int health = hero.Health;

        double armor = hero.Armor;
        double attackSpeedBonus = agi * 0.02;
        double atkTime = hero.AttackTime / (1 + attackSpeedBonus);

        double attack = hero.Attack;
        int range = hero.WeaponType == WeaponTypeEnum.Melee ? -1 : hero.Range;

        hero.Level = 1;

        return (str, agi, intl, health, armor, attack, atkTime, range);
    }

    // private (int str, int agi, int intl, int health, double armor, double attack, double atkTime, int range)
    //     GetAttributes(IHero hero, int level)
