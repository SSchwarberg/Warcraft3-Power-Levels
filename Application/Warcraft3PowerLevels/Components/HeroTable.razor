    //     if (level < 1) level = 1;
    //     int gained = level - 1;

    //     int str = hero.Strength + (int)(hero.StrengthGain * gained);
    //     int agi = hero.Agility + (int)(hero.AgilityGain * gained);
    //     int intl = hero.Intelligence + (int)(hero.IntelligenceGain * gained);

    //     int health = 100 + (str * 25);

    //     double armor = hero.Armor + (agi * 0.3);
    //     double attackSpeedBonus = agi * 0.02;
    //     double atkTime = hero.AttackTime / (1 + attackSpeedBonus);

    //     int primary = hero.PrimaryAttribute switch
    //     {
    //         PrimaryAttributeEnum.Strength => str,
    //         PrimaryAttributeEnum.Agility => agi,
    //         PrimaryAttributeEnum.Intelligence => intl,
    //         _ => 0
    //     };

    //     double attack = hero.Attack + primary;
    //     int range = hero.Range == 100 ? -1 : hero.Range;

    //     return (str, agi, intl, health, armor, attack, atkTime, range);
    // }

    private object? selectedEntity = null;

    private void ShowDetails(IHero hero)
    {
        selectedEntity = hero;
    }

    private void CloseDialog()
    {
        selectedEntity = null;
    }
}
