@using System.Globalization
@using Warcraft3PowerLevels.Entities.General

<table class="table">
    <thead>
        <tr>
            <th @onclick="() => Sort(h => h.Name)">Name</th>
            <th @onclick="() => Sort(h => h.Race)">Race</th>
            <th @onclick="() => Sort(h => h.PrimaryAttribute)">Primary</th>
            <th>Strength</th>
            <th>Agility</th>
            <th>Intelligence</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var hero in SortState.Apply(Heroes))
        {
            var (str, agi, intl) = GetAttributes(hero, Level);

            <tr>
                <td>@hero.Name</td>
                <td>@hero.Race</td>
                <td>@hero.PrimaryAttribute</td>
                <td>@str</td>
                <td>@agi</td>
                <td>@intl</td>
            </tr>
        }
    </tbody>
</table>

@code {
    [Parameter] public IEnumerable<IHero> Heroes { get; set; } = [];
    [Parameter] public int Level { get; set; }
    [Parameter] public EventCallback<Func<IHero, object>> OnSort { get; set; }
    [Parameter] public SortState<IHero> SortState { get; set; } = new();

    private void Sort(Func<IHero, object> selector)
    {
        OnSort.InvokeAsync(selector);
    }

    private (int str, int agi, int intl) GetAttributes(IHero hero, int level)
    {
        if (level <= 1) return (hero.Strength, hero.Agility, hero.Intelligence);

        int levelsGained = level - 1;

        int str = hero.Strength + (int)(hero.StrengthGain * levelsGained);
        int agi = hero.Agility + (int)(hero.AgilityGain * levelsGained);
        int intl = hero.Intelligence + (int)(hero.IntelligenceGain * levelsGained);

        return (str, agi, intl);
    }
}
