@page "/UnitStats/Power"
@using Warcraft3PowerLevels.Components
@using Warcraft3PowerLevels.Services
@using Warcraft3PowerLevels.Entities.Enumerations
@using Warcraft3PowerLevels.Entities.General

@inject UnitRepository Repository

<h3>Units - Power</h3>

<!-- TOP FILTER PANEL -->
<div class="top-filter-panel">

    <!-- LEFT: RACE FILTER INSIDE ITS OWN GLASS PANEL -->
    <div class="race-filter-container">
        <div class="race-filter-section">

            <div class="race-filter no-select">
                <span class="race-item @(IsMainRace(null) ? "active" : "")"
                      @onclick="@(() => SelectMainRace(null))">
                    All
                </span>

                @foreach (var race in new[] { RaceEnum.Human, RaceEnum.Orc, RaceEnum.Undead, RaceEnum.NightElf })
                {
                    <span class="race-item @(IsMainRace(race) ? "active" : "")"
                          @onclick="@(() => SelectMainRace(race))"
                          @key="race">
                        @race
                    </span>
                }
            </div>

            <div class="neutral-toggle no-select">
                <span class="race-item @(includeNeutralUnits ? "active" : "")"
                      @onclick="ToggleNeutralUnits">
                    Neutral Units
                </span>

                <span class="race-item @(includeSummons ? "active" : "")"
                      @onclick="ToggleSummons">
                    Summons
                </span>
            </div>

        </div>
    </div>

    <!-- RIGHT: ENEMY ATTACK / ARMOR TYPE PANEL -->
    <div class="type-filter-panel">
        <div class="panel-title">Enemy Attack Type</div>
        <div class="icon-row">
            @foreach (var atk in Enum.GetValues<AttackTypeEnum>())
            {
                if (atk == AttackTypeEnum.None)
                    continue;

                <img src="@($"/icons/attack/{atk}.png")"
                     title="@atk"
                     class="filter-icon @(selectedAttack == atk ? "active" : "")"
                     @onclick="(() => SelectAttack(atk))" />
            }
        </div>

        <div class="panel-title">Enemy Armor Type</div>
        <div class="icon-row">
            @foreach (var arm in Enum.GetValues<ArmorTypeEnum>())
            {
                if (arm == ArmorTypeEnum.None)
                    continue;

                <img src="@($"/icons/armor/{arm}.png")"
                     title="@arm"
                     class="filter-icon @(selectedArmor == arm ? "active" : "")"
                     @onclick="(() => SelectArmor(arm))" />
            }
        </div>
    </div>

</div>


<!-- TABLE -->
<UnitPowerTable Rows="PowerRows"
                TopDps="Top5Dps"
                BottomDps="Bottom5Dps"
                TopHp="Top5Hp"
                BottomHp="Bottom5Hp"
                TopPower="Top5Power"
                BottomPower="Bottom5Power"
                OnSort="HandleSort"
                SortState="sortState" />


@code {
    private RaceEnum? selectedMainRace = null;
    private AttackTypeEnum selectedAttack = AttackTypeEnum.None;
    private ArmorTypeEnum selectedArmor = ArmorTypeEnum.None;
    private bool includeNeutralUnits = false;
    private bool includeSummons = false;

    private void SelectMainRace(RaceEnum? race) => selectedMainRace = race;

    private void SelectAttack(AttackTypeEnum atk)
        => selectedAttack = selectedAttack == atk ? AttackTypeEnum.None : atk;

    private void SelectArmor(ArmorTypeEnum arm)
        => selectedArmor = selectedArmor == arm ? ArmorTypeEnum.None : arm;

    private void ToggleNeutralUnits() => includeNeutralUnits = !includeNeutralUnits;
    private void ToggleSummons() => includeSummons = !includeSummons;
    private bool IsMainRace(RaceEnum? race) => selectedMainRace == race;


    /* -------------------------------------------------------------
       FILTERED UNIT LIST
       ------------------------------------------------------------- */

    private IEnumerable<IUnit> FilteredUnits
    {
        get
        {
            var units = Repository.Units.ToList();

            if (selectedMainRace != null)
                units = units.Where(u =>
                    u.Race == selectedMainRace ||
                    u.Race == RaceEnum.Neutral
                ).ToList();

            if (!includeNeutralUnits)
                units = units.Where(u => u.Race != RaceEnum.Neutral).ToList();

            if (!includeSummons)
                units = units.Where(u => u is not ISummon).ToList();

            return units;
        }
    }


    /* -------------------------------------------------------------
       UNIT POWER ROWS (UPDATED CALCULATION)
       ------------------------------------------------------------- */
    private IEnumerable<UnitPowerRow> PowerRows =>
        FilteredUnits.Select(u =>
        {
            var dps = PowerCalculator.ComputeDpsVsTarget(u, selectedArmor);
            var effHp = (int)PowerCalculator.ComputeEffectiveHp(u, selectedAttack);
            var power = PowerCalculator.ComputePower(u, selectedAttack, selectedArmor);

            return new UnitPowerRow(u, dps, effHp, power);
        });



    /* -------------------------------------------------------------
       SORTING
       ------------------------------------------------------------- */

    private SortState<UnitPowerRow> sortState = new();

    private void HandleSort(Func<UnitPowerRow, object> selector)
    {
        if (sortState.KeySelector != selector)
        {
            sortState.KeySelector = selector;
            sortState.Direction = SortDirectionEnum.Descending;
        }
        else
        {
            sortState.Direction =
                sortState.Direction == SortDirectionEnum.Ascending
                ? SortDirectionEnum.Descending
                : SortDirectionEnum.Ascending;
        }
    }


    /* -------------------------------------------------------------
       TOP-BOTTOM RANKS
       ------------------------------------------------------------- */

    private List<UnitPowerRow> Top5Dps =>
        PowerRows.OrderByDescending(r => r.Dps).Take(5).ToList();

    private List<UnitPowerRow> Bottom5Dps =>
        PowerRows.OrderBy(r => r.Dps).Take(5).ToList();

    private List<UnitPowerRow> Top5Hp =>
        PowerRows.OrderByDescending(r => r.EffectiveHp).Take(5).ToList();

    private List<UnitPowerRow> Bottom5Hp =>
        PowerRows.OrderBy(r => r.EffectiveHp).Take(5).ToList();

    private List<UnitPowerRow> Top5Power =>
        PowerRows.OrderByDescending(r => r.Power).Take(5).ToList();

    private List<UnitPowerRow> Bottom5Power =>
        PowerRows.OrderBy(r => r.Power).Take(5).ToList();
}
