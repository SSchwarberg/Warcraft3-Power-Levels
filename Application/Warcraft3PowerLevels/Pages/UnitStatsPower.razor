@page "/UnitStats/Power"
@using Warcraft3PowerLevels.Components
@using Warcraft3PowerLevels.Services
@using Warcraft3PowerLevels.Entities.Enumerations
@using Warcraft3PowerLevels.Entities.General

@inject UnitRepository Repository

<h3>Unit Power Levels</h3>

<div class="race-filter-container">

    <!-- MAIN RACES -->
    <div class="race-filter no-select">
        <span class="race-item @(IsMainRace(null) ? "active" : "")"
              @onclick="@(() => SelectMainRace(null))">
            All
        </span>

        @foreach (var race in new[] { RaceEnum.Human, RaceEnum.Orc, RaceEnum.Undead, RaceEnum.NightElf })
        {
            <span class="race-item @(IsMainRace(race) ? "active" : "")"
                  @onclick="@(() => SelectMainRace(race))"
                  @key="race">
                @race
            </span>
        }
    </div>

    <!-- NEUTRAL + SUMMON FILTERS -->
    <div class="neutral-toggle no-select">
        <span class="race-item @(includeNeutralUnits ? "active" : "")"
              @onclick="ToggleNeutralUnits">
            Neutral Units
        </span>

        <span class="race-item @(includeSummons ? "active" : "")"
              @onclick="ToggleSummons">
            Summons
        </span>
    </div>
</div>

<UnitPowerTable Rows="PowerRows"
                OnSort="HandleSort"
                SortState="sortState" />

@code {
    private RaceEnum? selectedMainRace = null;
    private bool includeNeutralUnits = false;
    private bool includeSummons = false;

    private bool IsMainRace(RaceEnum? race) => selectedMainRace == race;

    private void SelectMainRace(RaceEnum? race)
    {
        selectedMainRace = race;
    }

    private void ToggleNeutralUnits() => includeNeutralUnits = !includeNeutralUnits;
    private void ToggleSummons() => includeSummons = !includeSummons;

    // Filtered units (same behavior as BaseUnitStatsPage)
    private IEnumerable<IUnit> FilteredUnits
    {
        get
        {
            var units = Repository.Units;

            // Race filter (including Neutral only when explicitly toggled)
            if (selectedMainRace != null)
                units = units.Where(u => u.Race == selectedMainRace || u.Race == RaceEnum.Neutral).ToList();

            if (!includeNeutralUnits)
                units = units.Where(u => u.Race != RaceEnum.Neutral).ToList();

            if (!includeSummons)
                units = units.Where(u => u is not ISummon).ToList();

            return units;
        }
    }

    // Convert IUnit → UnitPowerRow using PowerCalculator
    private IEnumerable<UnitPowerRow> PowerRows =>
        FilteredUnits.Select(u => new UnitPowerRow(
            u,
            PowerCalculator.ComputeDps(u),
            PowerCalculator.ComputeEffectiveHp(u),
            PowerCalculator.ComputePower(u)
        ));

    private SortState<UnitPowerRow> sortState = new();

    private void HandleSort(Func<UnitPowerRow, object> selector)
    {
        if (sortState.KeySelector != selector)
        {
            sortState.KeySelector = selector;
            sortState.Direction = SortDirectionEnum.Ascending;
        }
        else
        {
            sortState.Direction =
                sortState.Direction == SortDirectionEnum.Ascending
                ? SortDirectionEnum.Descending
                : SortDirectionEnum.Ascending;
        }
    }
}
