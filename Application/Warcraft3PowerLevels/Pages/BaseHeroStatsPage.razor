@page "/heroStats"
@using Warcraft3PowerLevels.Components.Services
@using Warcraft3PowerLevels.Entities.Enumerations
@using Warcraft3PowerLevels.Entities.General
@using Warcraft3PowerLevels.Components
@inject UnitRepository Repository
@inject Warcraft3PowerLevels.Components.Services.LayoutStateService LayoutState

<h3>Heroes</h3>

<div class="race-filter-container">
    <div class="race-filter no-select">
        <span class="race-item @(IsSelected(null) ? "active" : "")"
              @onclick="@(() => SelectRace(null))">
            All
        </span>

        @foreach (var race in Enum.GetValues<RaceEnum>())
        {
            <span class="race-item @(IsSelected(race) ? "active" : "")"
                  @onclick="@(() => SelectRace(race))"
                  @key="race">
                @race
            </span>
        }
    </div>

    <div class="level-control no-select">
        Level: @heroLevel
        <input type="range" min="1" max="10" @bind="heroLevel" />
    </div>
</div>

<HeroTable Heroes="FilteredHeroes"
           Level="heroLevel"
           OnSort="HandleSort"
           SortState="sortState" />

@code {
    private RaceEnum? selectedRace = null; // null = All races
    private int heroLevel = 1;
    private SortState<IHero> sortState = new();

    protected override void OnInitialized()
    {
        // Default sorting: Name ascending
        sortState.KeySelector = HeroTable.NameSelector;
        sortState.Direction = SortDirectionEnum.Ascending;

        // Setup sidebar dynamic menu
        LayoutState.SetContext("Heroes", new()
        {
            ("Base Stats", "/HeroStats"),
            ("Power Levels", "/HeroStats/Power"),
            ("Growth", "/HeroStats/Growth")
        });
    }

    private bool IsSelected(RaceEnum? race) => selectedRace == race;

    private void SelectRace(RaceEnum? race)
    {
        selectedRace = race;
    }

    private IEnumerable<IHero> FilteredHeroes =>
        selectedRace == null
            ? Repository.Heroes
            : Repository.Heroes.Where(h => h.Race == selectedRace);

    private void HandleSort(Func<IHero, object> selector)
    {
        if (sortState.KeySelector != selector)
        {
            sortState.KeySelector = selector;
            sortState.Direction = SortDirectionEnum.Ascending;
        }
        else
        {
            sortState.Direction =
                sortState.Direction == SortDirectionEnum.Ascending
                ? SortDirectionEnum.Descending
                : SortDirectionEnum.Ascending;
        }
    }
}
