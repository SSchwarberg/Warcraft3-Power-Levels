@page "/unitStats"
@using Warcraft3PowerLevels.Components
@using Warcraft3PowerLevels.Services
@using Warcraft3PowerLevels.Entities.Enumerations
@using Warcraft3PowerLevels.Entities.General
@inject UnitRepository Repository
@inject FilterStateService FilterState
@inject Warcraft3PowerLevels.Services.LayoutStateService LayoutState

<h3>Units - Base Stats</h3>

<div class="race-filter-container">

    <!-- MAIN RACES -->
    <div class="race-filter no-select">
        <span class="race-item @(IsMainRace(null) ? "active" : "")"
              @onclick="@(() => SelectMainRace(null))">
            All
        </span>

        @foreach (var race in new[] { RaceEnum.Human, RaceEnum.Orc, RaceEnum.Undead, RaceEnum.NightElf })
        {
            <span class="race-item @(IsMainRace(race) ? "active" : "")"
                  @onclick="@(() => SelectMainRace(race))"
                  @key="race">
                @race
            </span>
        }
    </div>

    <!-- NEUTRAL + SUMMONS SWITCHES -->
    <div class="neutral-toggle no-select">
        <span class="race-item @(includeNeutralUnits ? "active" : "")"
              @onclick="ToggleNeutralUnits">
            Neutral Units
        </span>

        <span class="race-item @(includeSummons ? "active" : "")"
              @onclick="ToggleSummons">
            Summons
        </span>
    </div>
</div>


<UnitTable Units="FilteredUnits"
           OnSort="HandleSort"
           SortState="sortState" />

@code {
    private RaceEnum? selectedRace = null;

    private bool IsActive(RaceEnum? race) => selectedRace == race;

    private RaceEnum? selectedMainRace
    {
        get => FilterState.UnitRace;
        set => FilterState.UnitRace = value;
    }

    private bool includeNeutralUnits => FilterState.UnitIncludeNeutral;

    private bool includeSummons => FilterState.UnitIncludeSummons;

    protected override void OnInitialized()
    {
        // Load race filter
        selectedMainRace = FilterState.UnitRace;
    }

    private void SelectRace(RaceEnum? race)
    {
        selectedRace = race;
    }

    private AttackTypeEnum selectedAttack
    {
        get => FilterState.SelectedAttack;
        set => FilterState.SelectedAttack = value;
    }

    private ArmorTypeEnum selectedArmor
    {
        get => FilterState.SelectedArmor;
        set => FilterState.SelectedArmor = value;
    }


    private bool IsMainRace(RaceEnum? race) => selectedMainRace == race;

    private void SelectMainRace(RaceEnum? race)
        => selectedMainRace = race;

    private void ToggleNeutralUnits() =>
        FilterState.UnitIncludeNeutral = !FilterState.UnitIncludeNeutral;

    private void ToggleSummons() =>
        FilterState.UnitIncludeSummons = !FilterState.UnitIncludeSummons;

    private IEnumerable<IUnit> FilteredUnits
{
    get
    {
        var units = Repository.Units;

        // Apply main race filter (excluding Neutral)
        if (selectedMainRace != null)
            units = units.Where(u => u.Race == selectedMainRace || u.Race == RaceEnum.Neutral).ToList();

        // Neutral Units toggle (Bandits, creeps, mercs → RaceEnum.Neutral)
        if (!includeNeutralUnits)
            units = units.Where(u => u.Race != RaceEnum.Neutral).ToList();

        // Summons toggle (Elementals, Wolves → UnitType.Summon)
        if (!includeSummons)
            units = units.Where(u => u is not ISummon).ToList();

        return units;
    }
}


    private SortState<IUnit> sortState = new();
    private void HandleSort(Func<IUnit, object> selector)
    {
        if (sortState.KeySelector != selector)
        {
            sortState.KeySelector = selector;
            sortState.Direction = SortDirectionEnum.Descending;
        }
        else
        {
            sortState.Direction =
                sortState.Direction == SortDirectionEnum.Ascending
                ? SortDirectionEnum.Descending
                : SortDirectionEnum.Ascending;
        }
    }
}
